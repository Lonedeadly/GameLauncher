<Window x:Class="GameLauncher.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLauncher — первый запуск"
        Width="660" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1F22"
        Foreground="#FFE8E8EA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8EA" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#FF3A3D42" />
            <Setter Property="Foreground" Value="#FFE8E8EA" />
            <Setter Property="BorderBrush" Value="#FF55585F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">

        <TextBlock Text="Куда ставить игры" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Margin="0,10,0,0" Foreground="#FFA8ABB2"
                   Text="Лаунчер портативный и не угадывает место сам. Выберите папку — он будет писать только в неё и никуда больше." />

        <TextBlock x:Name="WhyText" Margin="0,8,0,0" Foreground="#FF8A8D95" FontSize="12" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox"
                     Padding="8,7" VerticalContentAlignment="Center"
                     Background="#FF141519" Foreground="#FFE8E8EA"
                     BorderBrush="#FF55585F" BorderThickness="1"
                     TextChanged="PathBox_TextChanged" />

            <Button Grid.Column="1" Margin="8,0,0,0" Content="Обзор…" Click="Browse_Click" />
        </Grid>

        <!-- Место под сообщение зарезервировано, чтобы окно не прыгало,
             когда вердикт меняется по мере набора пути. -->
        <TextBlock x:Name="VerdictText" Margin="0,12,0,0" MinHeight="34" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Click="Cancel_Click" />
            <Button x:Name="OkButton" Margin="8,0,0,0" Content="Продолжить"
                    IsDefault="True" Click="Ok_Click"
                    Background="#FF2F6FEB" BorderBrush="#FF2F6FEB" />
        </StackPanel>

    </StackPanel>
</Window>
