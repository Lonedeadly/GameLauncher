<Window x:Class="GameLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLauncher" Height="600" Width="960" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1F22" Foreground="#FFE8E8EA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8EA" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A8D95" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="#FF3A3D42" />
            <Setter Property="Foreground" Value="#FFE8E8EA" />
            <Setter Property="BorderBrush" Value="#FF55585F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2F6FEB" />
            <Setter Property="BorderBrush" Value="#FF2F6FEB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Строка списка: название, состояние, точка при наличии обновления. -->
        <DataTemplate x:Key="GameRow">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="6" Background="#FF3A3D42">
                    <TextBlock Text="{Binding ImagePlaceholder}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StateCaption}" Style="{StaticResource Dim}" FontSize="11" />
                </StackPanel>

                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#FF6FC276"
                         VerticalAlignment="Center" Margin="6,0,4,0"
                         Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                         ToolTip="Есть обновление" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Обновление самого лаунчера. Самой верхней строкой и заметным
             цветом: это единственное, что друг не может узнать иначе. -->
        <Border Grid.Row="0" Background="#FF1E3A24" BorderBrush="#FF2F6B3C"
                BorderThickness="0,0,0,1" Padding="14,10"
                Visibility="{Binding ShowLauncherBar, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding LauncherHeadline}" Foreground="#FFB9E7C2"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Binding LauncherProgressText}" Foreground="#FF8FC79B"
                               FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding LauncherBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Mode=OneWay обязателен: ProgressBar.Value связывается
                         TwoWay по умолчанию, а свойство только для чтения. -->
                    <ProgressBar Height="5" Maximum="100" Margin="0,6,0,0"
                                 Value="{Binding LauncherProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding LauncherProgressIndeterminate, Mode=OneWay}"
                                 Background="#FF17301D" Foreground="#FF4FA860" BorderThickness="0"
                                 Visibility="{Binding LauncherBusy, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding LauncherError}" Foreground="#FFE58A6A" Margin="0,4,0,0"
                               Visibility="{Binding HasLauncherError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Button Grid.Column="1" Content="Обновить и перезапустить" Margin="14,0,0,0"
                        Style="{StaticResource Accent}"
                        Command="{Binding UpdateLauncherCommand}"
                        Visibility="{Binding HasLauncherUpdate, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Полоска сообщений: каталог из копии, лимит исчерпан и т.п. -->
        <Border Grid.Row="1" Background="#FF3A2F1E" Padding="14,9"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Notice}" Foreground="#FFE7C88A" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- слева: список игр -->
            <Border Background="#FF17181B" BorderBrush="#FF2A2C31" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Games}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ItemTemplate="{StaticResource GameRow}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <!-- пусто: список не загрузился и копии нет -->
            <StackPanel Grid.Column="1" MaxWidth="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Список игр пуст" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextAlignment="Center"
                           Text="Каталог не удалось загрузить, а сохранённой копии ещё нет. Проверьте связь и нажмите «Обновить»." />
            </StackPanel>

            <!-- справа: карточка выбранной игры -->
            <ScrollViewer x:Name="CardPane" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,24" DataContext="{Binding Selected}">

                    <StackPanel Orientation="Horizontal">
                        <Border Width="96" Height="96" CornerRadius="10" Background="#FF3A3D42">
                            <TextBlock Text="{Binding ImagePlaceholder}" FontSize="44" FontWeight="Light"
                                       Foreground="#FF8A8D95"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StateCaption}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,20,0,0" />

                    <!-- версии -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Установлено" Style="{StaticResource Dim}" Margin="0,0,16,6" />
                        <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontFamily="Consolas" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="Доступно" Style="{StaticResource Dim}" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailableVersion}" FontFamily="Consolas" />
                    </Grid>

                    <!-- примечание: сборок нет, раздача недоступна -->
                    <TextBlock Text="{Binding Note}" Foreground="#FFE7C88A" Margin="0,16,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding Error}" Foreground="#FFE58A6A" Margin="0,10,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- кнопки -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding PrimaryAction}"
                                Command="{Binding PrimaryCommand}"
                                Style="{StaticResource Accent}" MinWidth="130"
                                Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Удалить" Margin="10,0,0,0"
                                Command="{Binding UninstallCommand}"
                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- прогресс установки -->
                    <StackPanel Margin="0,22,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Dim}" Margin="0,0,0,6" />
                        <!-- Mode=OneWay обязателен: ProgressBar.Value связывается
                             TwoWay по умолчанию, а свойство только для чтения. -->
                        <ProgressBar Height="6" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                     Background="#FF2A2C31" Foreground="#FF2F6FEB" BorderThickness="0" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- подвал -->
        <Border Grid.Row="3" Background="#FF17181B" BorderBrush="#FF2A2C31" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding LibraryPath}" Style="{StaticResource Dim}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="Папка с играми" />

                <TextBlock Grid.Column="1" Text="{Binding LauncherVersion}" Style="{StaticResource Dim}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />

                <TextBlock Grid.Column="2" Text="{Binding Checked}" Style="{StaticResource Dim}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0" />

                <Button Grid.Column="3" Content="Обновить" Padding="12,5"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
